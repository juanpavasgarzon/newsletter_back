# App (app.*)
PORT=8000
NODE_ENV=development
API_PREFIX=api

# the front end URL used for CORS and email links (e.g. articles)
FRONTEND_URL=http://localhost:5173

# the secret used to sign cookies
COOKIE_SECRET=optional-signed-cookies

# Database (database.*) PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/newsletter

# Site JSON files dir (siteFiles.*)
CONFIG_DIR=./config

# Auth (auth.*)
ADMIN_SECRET=change-me-in-production
JWT_SECRET=jwt-secret-change-in-production
JWT_EXPIRES_IN_SECONDS=604800

# Email (newsletter notifications on new article)
# If not set, subscription works but no emails are sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
