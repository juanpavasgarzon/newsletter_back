# All vars loaded by @nestjs/config (registerAs sections: app, database, auth, mail, siteFiles)

# App (app.*)
PORT=3001
NODE_ENV=development
API_PREFIX=api
# FRONTEND_URL: usada para CORS y enlaces en emails (ej. artículos)
FRONTEND_URL=http://localhost:5173
# COOKIE_SECRET=optional-signed-cookies

# Database (database.*)
DATABASE_PATH=data/newsletter.sqlite

# Site JSON files dir (siteFiles.*)
# CONFIG_DIR=./config

# Auth (auth.*)
ADMIN_SECRET=change-me-in-production
JWT_SECRET=jwt-secret-change-in-production
# JWT_EXPIRES_IN_SECONDS=604800  # 7 days; default in auth.config

# Email (newsletter notifications on new article)
# If not set, subscription works but no emails are sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
